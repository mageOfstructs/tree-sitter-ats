{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ats",
      "camelcase": "Ats",
      "title": "ATS",
      "scope": "source.ats",
      "file-types": [
        "pats",
        "ats",
        "dats"
      ],
      "injection-regex": "^ats$",
      "class-name": "TreeSitterAts"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPLv3",
    "description": "Applied Type System",
    "authors": [
      {
        "name": "mage",
        "email": "mageOfStructs@proton.me",
        "url": "https://dwagon.org"
      }
    ],
    "links": {
      "repository": "https://git.dwagon.org/mage/tree-sitter-ats",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": true
  }
}